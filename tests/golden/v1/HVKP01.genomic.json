        "text": {
          "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n    <h3>Klebsiella pneumoniae Predicted Susceptibility Panel</h3>\n    <p><strong>Sample:</strong> HVKP01</p>\n    <p><strong>Method:</strong> Whole Genome Sequencing - Genotypic Prediction</p>\n    <p><strong>Panel:</strong> 12 antimicrobials</p>\n    <p><strong>Summary:</strong> 1 Resistant (including 1 intrinsic), 11 Susceptible</p>\n    <table border=\"1\">\n        <tr><th>Antimicrobial</th><th>Predicted Result</th></tr>\n        <tr><td>Ampicillin</td><td><strong>Resistant</strong></td></tr><tr><td>Amoxicillin-Clavulanate</td><td><strong>Susceptible</strong></td></tr><tr><td>Piperacillin-Tazobactam</td><td><strong>Susceptible</strong></td></tr><tr><td>Cefotaxime</td><td><strong>Susceptible</strong></td></tr><tr><td>Ceftazidime</td><td><strong>Susceptible</strong></td></tr><tr><td>Cefepime</td><td><strong>Susceptible</strong></td></tr><tr><td>Meropenem</td><td><strong>Susceptible</strong></td></tr><tr><td>Ciprofloxacin</td><td><strong>Susceptible</strong></td></tr><tr><td>Gentamicin</td><td><strong>Susceptible</strong></td></tr><tr><td>Amikacin</td><td><strong>Susceptible</strong></td></tr><tr><td>Trimethoprim-Sulfamethoxazole</td><td><strong>Susceptible</strong></td></tr><tr><td>Colistin</td><td><strong>Susceptible</strong></td></tr>\n    </table>\n    </div>",
