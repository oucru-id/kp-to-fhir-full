
manifest {
    name            = 'oucru-id/kp-to-fhir-full'
    description     = 'Klebsiella pneumoniae WGS to Kleborate typing, AMR, plasmids, cgMLST and HL7 FHIR Genomics reports'
    homePage        = 'https://github.com/oucru-id/kp-to-fhir-full'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '2.0.0'
    license         = 'MIT'
}

plugins {
    id 'nf-schema@2.5.1'
}

params {
    input       = null
    reads_dir   = null
    outdir      = 'results'
    results_dir = null

    genome_size           = '5.5m'
    nanopore_min_q        = 10
    nanopore_min_l        = 500
    medaka_model          = 'r941_min_sup_g507'
    medaka_batch_size     = 20
    min_nanopore_coverage = 30

    plasmid_analysis         = true
    mobsuite_db              = null
    mobsuite_db_cache        = "${projectDir}/db/mob_suite"
    plasmid_chrom_min_contig = 20000
    amr_locate_min_identity  = 90
    amr_locate_min_coverage  = 80

    cgmlst_schema = null

    fhir_profile           = 'generic'
    performer_org_id       = null
    performer_org_name     = null
    identifier_system_base = null
    patient_metadata       = null
    organization_metadata  = null
    practitioner_metadata  = null
    external_refs          = null
    require_clinical       = false
    bundle_request_method  = 'PUT'
    publish_clinical       = true

    skip_fhir_validation       = false
    fhir_validator             = 'https://github.com/hapifhir/org.hl7.fhir.core/releases/download/6.5.26/validator_cli.jar'
    fhir_ig                    = 'hl7.fhir.uv.genomics-reporting#3.0.0'
    fhir_tx_server             = 'n/a'
    fail_on_validation_error   = null
    fhir_validation_batch_size = 50

    fhir_server_url     = null
    fhir_auth_url       = null
    fhir_upload_api_key = false

    max_cpus   = Math.min(8, Runtime.runtime.availableProcessors())
    max_memory = '16 GB'
    max_time   = '24h'

    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    test_stub {
        includeConfig 'conf/test_stub.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    podman {
        podman.enabled      = true
        conda.enabled       = false
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        apptainer.enabled      = false
        podman.enabled         = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
    }
    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
