params {
    reads_dir       = "$baseDir/data/NGS"
    results_dir     = "$baseDir/results"
    illumina_suffix = '_illumina'
    nanopore_suffix = '_ont'
    fhir_validator     = "$baseDir/tools/fhir-validator.jar"
    cgmlst_schema      = "$baseDir/db/cgmlst_schema"
    patient_metadata        = "$baseDir/data/patient_clinical_metadata.csv"
    organization_metadata   = "$baseDir/data/organization_metadata.csv"
    practitioner_metadata   = "$baseDir/data/practitioner_metadata.csv"
    nanopore_min_q = 10
    nanopore_min_l = 500
    medaka_model   = 'r941_min_sup_g507'   // consensus model (not *_variant_*); must match flow cell + basecaller
    medaka_batch_size = 20                 // medaka default 100 needs >5 GB GPU memory; 20 fits a 4 GB GPU
    nanoplot_env          = null      // null = $HOME/miniforge3/envs/nanoplot
    genome_size_bp        = 5500000   // K. pneumoniae; used for the Nanopore coverage estimate
    min_nanopore_coverage = 30        // warn below this coverage (after chopper)
    plasmid_analysis         = true
    mobsuite_env             = null   // null = $HOME/miniforge3/envs/mobsuite
    mobsuite_db              = null   // null = the database installed by mob_init
    plasmid_chrom_min_contig = 20000
    amr_locate_min_identity  = 90
    amr_locate_min_coverage  = 80
    skip_upload              = true
    skip_validation          = true
    version         = "1.4.2"

}

process {
    withName: fastp {
        cpus = 4
        memory = '6 GB'
    }
    
    withName: megahit {
        cpus = 4
        memory = '8 GB' 
    }
    
    withName: chopper {
    cpus = 4
    memory = '6 GB'
    }

    withName: nanoplot {
        cpus = 4
        memory = '4 GB'
    }
    
    withName: flye {
        cpus = 8
        memory = '10 GB'
    }
    
    withName: CHEWBBACA {
        cpus = 8
        memory = '8 GB'
    }
    
    withName: medaka_polish {
        cpus = 8
        memory = '10 GB'
        maxForks = 1        // samples share one GPU
    }

    withName: pilon_polish {
        cpus = 4
        memory = '8 GB' 
    }
    
    withName: fastqc {
        cpus = 4
        memory = '8 GB'
    }

    withName: MULTIQC {
        cpus = 4
        memory = '8 GB'
    }

    withName: CREATE_FHIR {
        cpus = 4
        memory = '8 GB'
    }
    
    withName: VALIDATE_FHIR {
        cpus = 4
        memory = '4 GB'
    }

    withName: kleborate {
        cpus = 4
        memory = '8 GB'
    }

    withName: PLASMID_RECON {
        cpus = 4
        memory = '8 GB'
    }

    scratch = true
}

profiles {
    standard {
        process.executor = 'local'
    }
    
    hpc {
        process.executor = 'slurm'
        process.queue = 'normal'
    }
    
    test {
        params.reads_dir = 'test_data'
        params.max_threads = 2
    }
}

report {
    enabled = true
    file = "$baseDir/results/runningstat/execution.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "$baseDir/results/runningstat/timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "$baseDir/results/runningstat/dag.html"
    overwrite = true
}