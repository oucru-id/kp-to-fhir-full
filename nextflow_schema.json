{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/oucru-id/kp-to-fhir-full/main/nextflow_schema.json",
    "title": "oucru-id/kp-to-fhir-full pipeline parameters",
    "description": "Klebsiella pneumoniae WGS to Kleborate typing, AMR, plasmids, cgMLST and HL7 FHIR Genomics reports",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Give samples with --input, or with --reads_dir.",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Samplesheet CSV with columns sample,platform,fastq_1,fastq_2,fasta (platform illumina, ont or fasta)."
                },
                "reads_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Legacy input: directory of <id>_1_illumina.fastq.gz / <id>_2_illumina.fastq.gz and <id>_ont.fastq.gz files."
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "results",
                    "description": "Output directory."
                },
                "results_dir": {
                    "type": "string",
                    "hidden": true,
                    "description": "Removed in 2.0.0; use --outdir."
                }
            }
        },
        "assembly_options": {
            "title": "Read processing and assembly",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "properties": {
                "genome_size": {
                    "type": "string",
                    "default": "5.5m",
                    "pattern": "^\\d+(\\.\\d+)?[kmgKMG]?$",
                    "description": "Expected genome size, for Flye (--genome-size) and the Nanopore coverage estimate."
                },
                "nanopore_min_q": {
                    "type": [
                        "integer",
                        "string"
                    ],
                    "pattern": "^-?\\d+$",
                    "default": 10,
                    "description": "chopper minimum read quality."
                },
                "nanopore_min_l": {
                    "type": [
                        "integer",
                        "string"
                    ],
                    "pattern": "^-?\\d+$",
                    "default": 500,
                    "description": "chopper minimum read length."
                },
                "medaka_model": {
                    "type": "string",
                    "default": "r941_min_sup_g507",
                    "description": "medaka consensus model; must match the flow cell and basecaller of the ONT reads."
                },
                "medaka_batch_size": {
                    "type": [
                        "integer",
                        "string"
                    ],
                    "pattern": "^-?\\d+$",
                    "default": 20,
                    "minimum": 1,
                    "description": "medaka inference batch size (lower it when a GPU runs out of memory)."
                },
                "min_nanopore_coverage": {
                    "type": [
                        "number",
                        "string"
                    ],
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "default": 30,
                    "minimum": 0,
                    "description": "Warn, and flag the FHIR report, below this Nanopore read coverage (after chopper)."
                }
            }
        },
        "plasmid_options": {
            "title": "Plasmid analysis",
            "type": "object",
            "fa_icon": "fas fa-circle-notch",
            "properties": {
                "plasmid_analysis": {
                    "type": [
                        "boolean",
                        "string"
                    ],
                    "enum": [
                        true,
                        false,
                        "true",
                        "false"
                    ],
                    "default": true,
                    "description": "Run MOB-suite and locate Kleborate resistance genes on plasmids or the chromosome."
                },
                "mobsuite_db": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Initialised MOB-suite database directory. When unset, mob_init downloads it (about 3 GB) into --mobsuite_db_cache once."
                },
                "mobsuite_db_cache": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Where mob_init stores the MOB-suite database when --mobsuite_db is unset."
                },
                "plasmid_chrom_min_contig": {
                    "type": [
                        "integer",
                        "string"
                    ],
                    "pattern": "^-?\\d+$",
                    "default": 20000,
                    "minimum": 0,
                    "description": "Shortest chromosome contig (bp) on which a gene counts as chromosomal; shorter contigs are 'unresolved'."
                },
                "amr_locate_min_identity": {
                    "type": [
                        "number",
                        "string"
                    ],
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "default": 90,
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Minimum identity (%) of a CARD allele hit used to locate a gene."
                },
                "amr_locate_min_coverage": {
                    "type": [
                        "number",
                        "string"
                    ],
                    "pattern": "^-?\\d+(\\.\\d+)?$",
                    "default": 80,
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Minimum allele coverage (%) of a CARD allele hit used to locate a gene."
                }
            }
        },
        "cgmlst_options": {
            "title": "cgMLST",
            "type": "object",
            "fa_icon": "fas fa-project-diagram",
            "properties": {
                "cgmlst_schema": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "chewBBACA schema directory (tools/cgmlst/fetch_schema.sh). cgMLST is skipped when unset."
                }
            }
        },
        "fhir_output": {
            "title": "FHIR output",
            "type": "object",
            "fa_icon": "fas fa-file-medical",
            "properties": {
                "fhir_profile": {
                    "type": "string",
                    "default": "generic",
                    "enum": [
                        "generic",
                        "satusehat"
                    ],
                    "description": "generic: HL7 Genomics Reporting IG 3.0.0 only. satusehat: v1.4 output with Indonesian Ministry of Health (Kemkes) profiles, NIK identifiers and codings."
                },
                "performer_org_id": {
                    "type": "string",
                    "description": "FHIR id of the performing laboratory Organization, used as performer in the genomic bundles."
                },
                "performer_org_name": {
                    "type": "string",
                    "description": "Display name for the performing laboratory."
                },
                "identifier_system_base": {
                    "type": "string",
                    "format": "uri",
                    "description": "Base URI for business identifiers in the generic profile (none are emitted if unset)."
                }
            }
        },
        "clinical_metadata": {
            "title": "Clinical metadata (optional, contains personal data)",
            "type": "object",
            "fa_icon": "fas fa-user-shield",
            "description": "Give --patient_metadata to build Patient/Specimen/Encounter/ServiceRequest resources and linked transaction bundles.",
            "properties": {
                "patient_metadata": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.(csv|xlsx)$",
                    "description": "Patient table (CSV or XLSX); see docs/clinical_metadata.md."
                },
                "organization_metadata": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.(csv|xlsx)$",
                    "description": "Performing organization (first row is used)."
                },
                "practitioner_metadata": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.(csv|xlsx)$",
                    "description": "Responsible practitioner (first row is used)."
                },
                "external_refs": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "JSON {fhir_id: {\"Patient\": \"<server id>\", \"Encounter\": \"<server id>\"}} for resources that already exist on the server."
                },
                "require_clinical": {
                    "type": [
                        "boolean",
                        "string"
                    ],
                    "enum": [
                        true,
                        false,
                        "true",
                        "false"
                    ],
                    "default": false,
                    "description": "Fail when a sample has no row in the patient table (default: warn, genomic bundle only)."
                },
                "bundle_request_method": {
                    "type": "string",
                    "default": "PUT",
                    "enum": [
                        "PUT",
                        "POST"
                    ],
                    "description": "Transaction entry method. POST uses server-assigned ids and ifNoneExist on NIK (SATUSEHAT)."
                },
                "publish_clinical": {
                    "type": [
                        "boolean",
                        "string"
                    ],
                    "enum": [
                        true,
                        false,
                        "true",
                        "false"
                    ],
                    "default": true,
                    "description": "Publish the clinical resources to <outdir>/fhir/clinical."
                }
            }
        },
        "fhir_validation": {
            "title": "FHIR validation",
            "type": "object",
            "fa_icon": "fas fa-check-double",
            "properties": {
                "skip_fhir_validation": {
                    "type": [
                        "boolean",
                        "string"
                    ],
                    "enum": [
                        true,
                        false,
                        "true",
                        "false"
                    ],
                    "default": false,
                    "description": "Do not run the HL7 FHIR validator."
                },
                "fhir_validator": {
                    "type": "string",
                    "description": "validator_cli.jar: a local path or a URL (default: pinned HAPI FHIR core release)."
                },
                "fhir_ig": {
                    "type": "string",
                    "default": "hl7.fhir.uv.genomics-reporting#3.0.0",
                    "description": "Implementation guide package to validate against."
                },
                "fhir_tx_server": {
                    "type": "string",
                    "default": "n/a",
                    "description": "Terminology server for code validation; 'n/a' validates offline and sends nothing."
                },
                "fail_on_validation_error": {
                    "type": [
                        "boolean",
                        "string"
                    ],
                    "enum": [
                        true,
                        false,
                        "true",
                        "false"
                    ],
                    "description": "Stop the run when a bundle has validation errors (default: true for generic, false for satusehat)."
                },
                "fhir_validation_batch_size": {
                    "type": [
                        "integer",
                        "string"
                    ],
                    "pattern": "^-?\\d+$",
                    "default": 50,
                    "minimum": 1,
                    "description": "Files validated per validator process."
                }
            }
        },
        "fhir_upload": {
            "title": "FHIR upload",
            "type": "object",
            "fa_icon": "fas fa-cloud-upload-alt",
            "description": "Credentials are Nextflow secrets (KPFHIR_CLIENT_ID, KPFHIR_CLIENT_SECRET, KPFHIR_API_KEY), never parameters.",
            "properties": {
                "fhir_server_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "FHIR server base URL. Upload runs only when this is set."
                },
                "fhir_auth_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "OAuth2/OIDC realm URL for the client-credentials token."
                },
                "fhir_upload_api_key": {
                    "type": [
                        "boolean",
                        "string"
                    ],
                    "enum": [
                        true,
                        false,
                        "true",
                        "false"
                    ],
                    "default": false,
                    "description": "Also send the KPFHIR_API_KEY secret as an X-Api-Key header."
                }
            }
        },
        "resource_limits": {
            "title": "Resource limits",
            "type": "object",
            "fa_icon": "fas fa-microchip",
            "properties": {
                "max_cpus": {
                    "type": [
                        "integer",
                        "string"
                    ],
                    "pattern": "^-?\\d+$",
                    "default": 8,
                    "description": "Most CPUs any task may request."
                },
                "max_memory": {
                    "type": "string",
                    "default": "16 GB",
                    "pattern": "^\\d+(\\.\\d+)?\\s*(K|M|G|T)?B$",
                    "description": "Most memory any task may request, e.g. '16 GB'."
                },
                "max_time": {
                    "type": "string",
                    "default": "24h",
                    "description": "Longest any task may run, e.g. '24h'."
                },
                "trace_report_suffix": {
                    "type": "string",
                    "hidden": true,
                    "description": "Suffix for pipeline_info report file names (default: start time)."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/assembly_options"
        },
        {
            "$ref": "#/$defs/plasmid_options"
        },
        {
            "$ref": "#/$defs/cgmlst_options"
        },
        {
            "$ref": "#/$defs/fhir_output"
        },
        {
            "$ref": "#/$defs/clinical_metadata"
        },
        {
            "$ref": "#/$defs/fhir_validation"
        },
        {
            "$ref": "#/$defs/fhir_upload"
        },
        {
            "$ref": "#/$defs/resource_limits"
        }
    ]
}
