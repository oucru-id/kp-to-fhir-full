
process {
    publishDir = [enabled: false]

    withName: 'FASTQC' {
        publishDir = [path: { "${params.outdir}/qc/fastqc" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'FASTP' {
        publishDir = [path: { "${params.outdir}/qc/fastp" }, mode: 'copy', pattern: '*.{json,html}']
    }
    withName: 'NANOPLOT' {
        publishDir = [path: { "${params.outdir}/qc/nanoplot" }, mode: 'copy',
                      pattern: '*_{NanoPlot-report.html,NanoStats.txt,coverage_mqc.tsv}']
    }
    withName: 'ASSEMBLY_QC' {
        publishDir = [path: { "${params.outdir}/qc/assembly" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'MULTIQC' {
        publishDir = [path: { "${params.outdir}/qc/multiqc" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'PILON|MEDAKA_POLISH|PREPARE_ASSEMBLY' {
        publishDir = [path: { "${params.outdir}/assembly" }, mode: 'copy', pattern: '*.fasta']
    }
    withName: 'KLEBORATE|PARSE_KLEBORATE' {
        publishDir = [path: { "${params.outdir}/typing" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'MOB_RECON|AMR_LOCATE' {
        publishDir = [path: { "${params.outdir}/plasmid/${meta.id}" }, mode: 'copy', pattern: '*.{txt,paf,log}']
    }
    withName: 'PARSE_PLASMIDS|PLASMID_SHARING' {
        publishDir = [path: { "${params.outdir}/plasmid" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'CHEWBBACA' {
        publishDir = [path: { "${params.outdir}/cgmlst" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'SAMPLE_REPORT' {
        publishDir = [path: { "${params.outdir}/reports" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'FHIR_GENOMIC' {
        publishDir = [path: { "${params.outdir}/fhir/genomic" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'FHIR_CLINICAL' {
        publishDir = [path: { "${params.outdir}/fhir" }, mode: 'copy', pattern: 'clinical',
                      enabled: params.publish_clinical.toString().toBoolean()]
    }
    withName: 'FHIR_LINK' {
        publishDir = [path: { "${params.outdir}/fhir" }, mode: 'copy', pattern: 'bundle/*']
    }
    withName: 'FHIR_VALIDATE' {
        publishDir = [path: { "${params.outdir}/fhir/validation" }, mode: 'copy', pattern: 'validation.json',
                      saveAs: { _fn -> "validation_${task.index}.json" }]
    }
    withName: 'FHIR_UPLOAD|FHIR_UPLOAD_WITH_API_KEY' {
        publishDir = [path: { "${params.outdir}/fhir/upload" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
}
