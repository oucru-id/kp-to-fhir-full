
params {
    input                 = "${projectDir}/tests/data/samplesheet_stub.csv"
    outdir                = 'results_test_stub'
    cgmlst_schema         = "${projectDir}/tests/data/stub/cgmlst_schema"
    mobsuite_db_cache     = 'results_test_stub/mob_suite_cache'
    patient_metadata      = "${projectDir}/tests/fixtures/metadata/patient_clinical_metadata.csv"
    organization_metadata = "${projectDir}/tests/fixtures/metadata/organization_metadata.csv"
    practitioner_metadata = "${projectDir}/tests/fixtures/metadata/practitioner_metadata.csv"
    performer_org_id      = '99000001'
    fhir_validator        = "${projectDir}/assets/NO_FILE"
    max_cpus              = 2
    max_memory            = '4 GB'
}

process {
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
}
